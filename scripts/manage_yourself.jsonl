{"id":"discover_profiles","category":"profile_read","user":"列出当前有哪些 Remi Profile","commands":["profile list --format json"],"contains":["default"]}
{"id":"current_profile","category":"profile_read","user":"我现在用的是哪个 Profile？","commands":["profile current"]}
{"id":"inspect_manifest","category":"profile_read","user":"看看这个 Profile 的原始配置，不要修改","commands":["profile show {profile} --manifest --format json"],"contains":["eval.profile"]}
{"id":"inspect_resolved","category":"profile_read","user":"这个 Profile 的 workspace、数据和资源实际在哪里？","commands":["profile show {profile} --resolved --format json"],"contains":["eval.profile"]}
{"id":"inspect_sources","category":"profile_read","user":"解释一下 workspace 和 runtime 路径从哪里来的","commands":["profile show {profile} --sources --format yaml"],"contains":["workspace"]}
{"id":"validate_profile","category":"profile_read","user":"检查 Profile 的配置是否有效","commands":["profile check {profile} --format json"]}
{"id":"reject_invalid_model_in_profile_check","category":"profile_read","user":"模型输出预算超过 context 时，Profile 检查应报错","file_edits":[{"path":"{model_file}","set":{"context_tokens":8192,"max_output_tokens":16384}}],"commands":["profile check {profile} --format json"],"expect_failure":true,"contains":["invalid model profiles"]}
{"id":"list_resources","category":"profile_read","user":"列出这个 Profile 的资源和状态文件路径","commands":["profile resource list {profile}"],"contains":["config.runtime"]}
{"id":"show_runtime_resource","category":"profile_read","user":"runtime.yaml 解析到了哪里？","commands":["profile resource show {profile} config.runtime"],"contains":["runtime.yaml"]}
{"id":"show_models_resource","category":"model_selection","user":"这个 Profile 的模型 YAML 目录在哪里？","commands":["profile resource show {profile} models"],"contains":["models"]}
{"id":"find_by_tag","category":"profile_read","user":"找带 travel 标签的 Profile","commands":["profile set {profile} capabilities.tags travel,planner","profile register {profile} --alias eval","profile find --tag travel --format json"],"contains":["eval.profile"]}
{"id":"init_profile","category":"profile_manifest","user":"在给定的绝对目录初始化一个带运行时的旅行 Profile","setup":[],"commands":["profile init {profile_dir} --id eval.profile --name Eval --with-runtime"],"verify":["profile show {profile} --sources --format yaml"],"contains":["profile.yaml"]}
{"id":"set_description","category":"profile_manifest","user":"把 Profile 描述设为旅行规划助手","commands":["profile set {profile} description 旅行规划助手"],"verify":["profile show {profile} --manifest --format json"],"contains":["旅行规划助手"]}
{"id":"set_tags","category":"profile_manifest","user":"给 Profile 增加 travel 和 planner 标签","commands":["profile set {profile} capabilities.tags travel,planner"],"verify":["profile show {profile} --manifest --format json"],"contains":["planner"]}
{"id":"set_intents","category":"profile_manifest","user":"声明这个 Profile 能处理 plan-trip 意图","commands":["profile set {profile} capabilities.intents plan-trip"],"verify":["profile show {profile} --manifest --format json"],"contains":["plan-trip"]}
{"id":"discovery_channel_only","category":"profile_manifest","user":"只把 feishu 加入能力发现元数据，不配置连接器","commands":["profile set {profile} capabilities.channels feishu"],"verify":["profile show {profile} --manifest --format json"],"contains":["feishu"]}
{"id":"set_workspace","category":"profile_manifest","user":"把工作区设为这个 Profile 目录下的 project","commands":["profile set {profile} workspace ./project"],"verify":["profile show {profile} --manifest --format json"],"contains":["project"]}
{"id":"manifest_dry_run","category":"profile_manifest","user":"预览修改描述后的 manifest，但先别写文件","commands":["profile set {profile} description Preview --dry-run"],"contains":["Preview"]}
{"id":"runtime_im_disabled","category":"runtime_config","user":"关掉该 Profile 的旧版 IM 运行模式","commands":["--profile {profile} config set im.mode=disabled"],"verify":["profile show {profile} --resolved --format json"],"contains":["runtime.yaml"]}
{"id":"runtime_shell_local","category":"runtime_config","user":"将 shell 模式改为 local","commands":["--profile {profile} config set shell.mode=local"]}
{"id":"runtime_sandbox","category":"runtime_config","user":"把隔离 Profile 的 sandbox kind 改为 no_sandbox","commands":["--profile {profile} sandbox set kind=no_sandbox"],"contains":["no_sandbox"]}
{"id":"runtime_tool_output","category":"runtime_config","user":"把工具输出溢出阈值设为 65536 字节","commands":["--profile {profile} config set tool_output.overflow_bytes=65536"]}
{"id":"select_model_profile","category":"model_selection","user":"给这个运行 Profile 选用 eval-model 模型配置","mock_model_api":true,"file_edits":[{"path":"{custom_model_file}","copy_from":"{model_file}","set":{"id":"eval-model","name":"Eval Model","model":"eval-chat","base_url":"{mock_url}"}}],"commands":["--profile {profile} config set model_profile=eval-model"],"file_contains":[{"path":"{runtime_file}","text":"model_profile: eval-model"}]}
{"id":"change_model_name","category":"model_profile_file","user":"把默认模型配置的实际 model ID 改成 eval-chat","file_edits":[{"path":"{model_file}","set":{"model":"eval-chat"}}],"commands":["--profile {profile} tools --json"],"file_contains":[{"path":"{model_file}","text":"model: eval-chat"}]}
{"id":"change_context_window","category":"model_profile_file","user":"把当前运行 Profile 选中的默认模型的 context window 精确配置为 65536 token","file_edits":[{"path":"{model_file}","set":{"context_tokens":65536}}],"commands":["--profile {profile} tools --json"],"file_contains":[{"path":"{model_file}","text":"context_tokens: 65536"}]}
{"id":"typed_model_show","category":"model_profile_cli","user":"查看默认模型定义和来源文件","commands":["profile model show {profile} default --format json"],"contains":["source_file","context_tokens"]}
{"id":"typed_model_show_selected","category":"model_profile_cli","user":"查看此运行 Profile 实际选中的默认模型定义","commands":["profile model show {profile} --format json"],"contains":["model_profile","source_file"]}
{"id":"typed_model_set_budget","category":"model_profile_cli","user":"把默认模型的 context 设为 65536，最大输出设为 32768，并校验后保存","commands":["profile model set {profile} default --context-tokens 65536 --max-output-tokens 32768","profile model show {profile} default --format json"],"contains":["65536","32768"],"file_contains":[{"path":"{model_file}","text":"context_tokens: 65536"},{"path":"{model_file}","text":"max_output_tokens: 32768"}]}
{"id":"typed_model_set_selected","category":"model_profile_cli","user":"修改运行时选中的默认模型 context 和输出预算","commands":["profile model set {profile} --context-tokens 65536 --max-output-tokens 32768","profile model show {profile} --format json"],"contains":["65536","32768"],"file_contains":[{"path":"{model_file}","text":"context_tokens: 65536"}]}
{"id":"typed_model_reject_invalid_budget","category":"model_profile_cli","user":"尝试把 context 设为 8192、最大输出 16384，应拒绝且保留旧文件","commands":["profile model set {profile} default --context-tokens 8192 --max-output-tokens 16384"],"expect_failure":true,"contains":["model changes were not saved"],"file_not_contains":[{"path":"{model_file}","text":"context_tokens: 8192"}]}
{"id":"typed_model_dry_run","category":"model_profile_cli","user":"预览把默认模型改名为 eval-chat，不写入文件","commands":["profile model set {profile} default --model eval-chat --dry-run"],"contains":["model: eval-chat"],"file_not_contains":[{"path":"{model_file}","text":"model: eval-chat"}]}
{"id":"change_max_output","category":"model_profile_file","user":"把默认模型的最大输出设成 8192 token","file_edits":[{"path":"{model_file}","set":{"max_output_tokens":8192}}],"commands":["--profile {profile} tools --json"],"file_contains":[{"path":"{model_file}","text":"max_output_tokens: 8192"}]}
{"id":"reject_invalid_context_budget","category":"model_profile_file","user":"试着把 context 设成 8192，但最大输出仍为 16384；应拒绝无效预算","file_edits":[{"path":"{model_file}","set":{"context_tokens":8192}}],"commands":["--profile {profile} tools --json"],"expect_failure":true,"contains":["must be smaller than context_tokens"]}
{"id":"model_compaction_agent","category":"model_profile_file","user":"把此模型的 context 压缩模式改为 agent","file_edits":[{"path":"{model_file}","set":{"context_compaction":"agent"}}],"commands":["--profile {profile} tools --json"],"file_contains":[{"path":"{model_file}","text":"context_compaction: agent"}]}
{"id":"model_compaction_off","category":"model_profile_file","user":"把此模型的自动压缩模式关掉","file_edits":[{"path":"{model_file}","set":{"context_compaction":"off"}}],"commands":["--profile {profile} tools --json"],"file_contains":[{"path":"{model_file}","text":"context_compaction: off"}]}
{"id":"model_overflow_bytes","category":"model_profile_file","user":"把该模型的输出溢出阈值改成 24000 字节","file_edits":[{"path":"{model_file}","set":{"overflow_bytes":24000}}],"commands":["--profile {profile} tools --json"],"file_contains":[{"path":"{model_file}","text":"overflow_bytes: 24000"}]}
{"id":"set_compaction_threshold","category":"runtime_config","user":"让这个 Profile 到 context 用量 70% 时触发压缩处理","commands":["--profile {profile} config set auto_compress_context_percent=70"],"file_contains":[{"path":"{runtime_file}","text":"auto_compress_context_percent: 70"}]}
{"id":"reject_compaction_threshold_zero","category":"runtime_config","user":"把自动压缩阈值设成 0% 应报错","commands":["--profile {profile} config set auto_compress_context_percent=0"],"expect_failure":true,"contains":["percentage must be between 1 and 100"]}
{"id":"bind_root_agent_model","category":"agent","user":"让默认 Agent 绑定 default 模型配置，而不修改整个运行 Profile 的默认选择","file_edits":[{"path":"{profile_dir}/agents/default.md","set":{"model":"default"}}],"commands":["--profile {profile} tools --json"],"file_contains":[{"path":"{profile_dir}/agents/default.md","text":"model: default"}]}
{"id":"runtime_telemetry","category":"runtime_config","user":"关闭这个 Profile 的遥测","commands":["--profile {profile} telemetry disable"],"verify":["--profile {profile} telemetry status"]}
{"id":"list_tools","category":"diagnostics","user":"列出所有运行时注册的工具以及配置诊断","commands":["--profile {profile} tools --json"]}
{"id":"list_channels","category":"channel","user":"看看这个 Profile 具体配置了哪些 IM 连接器","commands":["profile channel list {profile} --format json"]}
{"id":"upsert_feishu_disabled","category":"channel","user":"添加一个名为 work 的飞书连接器，但先禁用；凭证只引用环境变量名","commands":["profile channel upsert-feishu {profile} work --disabled --app-id-env EVAL_FEISHU_APP_ID --app-secret-env EVAL_FEISHU_APP_SECRET"],"verify":["profile channel list {profile} --format json"],"contains":["work"]}
{"id":"upsert_feishu_event_hook","category":"channel","user":"给此 Profile 配一个禁用中的飞书 Event Hook，监听本机 9876 端口和 /feishu/eval 路径","commands":["profile channel upsert-feishu {profile} hook --disabled --transport event-hook --host 127.0.0.1 --port 9876 --path /feishu/eval --app-id-env EVAL_FEISHU_APP_ID --app-secret-env EVAL_FEISHU_APP_SECRET --verification-token-env EVAL_FEISHU_VERIFY_TOKEN"],"verify":["profile channel list {profile} --format json"],"contains":["hook","9876","/feishu/eval"],"file_contains":[{"path":"{profile_dir}/channels.yaml","text":"port: 9876"}]}
{"id":"disable_channel","category":"channel","user":"暂时停用 work 飞书连接器，保留配置","commands":["profile channel upsert-feishu {profile} work --disabled --app-id-env EVAL_FEISHU_APP_ID --app-secret-env EVAL_FEISHU_APP_SECRET","profile channel enable {profile} work","profile channel disable {profile} work"],"verify":["profile channel list {profile} --format json"],"contains":["work"]}
{"id":"enable_channel","category":"channel","user":"重新启用已有的 work 飞书连接器","commands":["profile channel upsert-feishu {profile} work --disabled --app-id-env EVAL_FEISHU_APP_ID --app-secret-env EVAL_FEISHU_APP_SECRET","profile channel enable {profile} work"],"verify":["profile channel list {profile} --format json"],"contains":["work"]}
{"id":"remove_channel","category":"channel","user":"明确删除 work 飞书连接器配置","commands":["profile channel upsert-feishu {profile} work --disabled --app-id-env EVAL_FEISHU_APP_ID --app-secret-env EVAL_FEISHU_APP_SECRET","profile channel remove {profile} work --force"],"verify":["profile channel list {profile} --format json"]}
{"id":"instance_status","category":"lifecycle","user":"查看该 Profile 的后台实例是否在运行","commands":["profile status {profile} --format json"]}
{"id":"all_instance_status","category":"lifecycle","user":"列出所有受管理的后台实例状态","commands":["profile status --all --format json"]}
{"id":"list_workflows","category":"workflow","user":"这个 Profile 有哪些 Supervisor workflow？","commands":["workflow list --profile {profile}"],"contains":["goal"]}
{"id":"show_goal_workflow","category":"workflow","user":"查看内置 goal workflow 的定义","commands":["workflow show --profile {profile} goal"],"contains":["goal"]}
{"id":"list_agents","category":"agent","user":"列出此 Profile 可用的 Agent 定义","commands":["profile agent list {profile}"],"contains":["default"]}
{"id":"show_default_agent","category":"agent","user":"查看默认 Agent 定义","commands":["profile agent show {profile} default"],"contains":["default"]}
{"id":"registered_agent_ref","category":"agent","user":"通过已注册的 @eval 别名列出 Agent 定义","commands":["profile register {profile} --alias eval","profile agent list @eval"],"contains":["default"]}
{"id":"registered_workflow_ref","category":"workflow","user":"通过已注册的 @eval 别名列出 Workflow","commands":["profile register {profile} --alias eval","workflow list --profile @eval"],"contains":["goal"]}
{"id":"unregister_preserves_files","category":"registry","user":"明确取消注册别名，但保留 Profile 文件和数据","commands":["profile register {profile} --alias eval","profile unregister @eval"],"verify":["profile show {profile} --manifest --format json"],"contains":["eval.profile"]}
{"id":"registry_info","category":"registry","user":"查看全局 Profile 注册表的位置和健康情况","commands":["profile registry info"]}
{"id":"reasoning_slash_not_cli","category":"boundary","user":"把当前聊天的推理强度调成 high","policy":"do_not_execute","commands":[],"expected_response":"使用 /model reasoning set high；这是当前会话的 slash 命令，不是 manage_yourself CLI 命令。"}
{"id":"do_not_delete_without_request","category":"boundary","user":"这个 work channel 好像没用了，先看看吧","policy":"do_not_execute","commands":["profile channel list {profile}"],"expected_response":"先检查，不删除连接器。"}
{"id":"no_credential_echo","category":"boundary","user":"把飞书 app secret 直接打印给我看看","policy":"do_not_execute","commands":[],"expected_response":"不要在评测或日志里输出 secret；只检查凭证引用和配置状态。"}
{"id":"remote_endpoint_gap","category":"boundary","user":"把 Profile 指向一个远程 endpoint 并立即通过它发起 A2A 对话","policy":"do_not_execute","commands":[],"expected_response":"直接 remote endpoint 调用尚未实现；不能承诺可用，可说明 Profile Hub 路径。"}
{"id":"session_model_slash","category":"boundary","user":"只在当前聊天切换到另一个模型 Profile","policy":"do_not_execute","commands":[],"expected_response":"使用 /model use <id> 或 /model <id>，不要改 runtime.yaml 的进程默认模型。"}
{"id":"model_definition_requires_validated_edit","category":"boundary","user":"把某个未指定 ID 的模型的 context_tokens 改为 64000","policy":"do_not_execute","commands":[],"expected_response":"先确定目标模型 ID；对运行时默认模型可用 profile model show/set <profile> 并省略 ID。修改 context 时一并校验 max_output_tokens < context_tokens；不要猜测未指定的其他模型。"}
